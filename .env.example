# GrocyScan 配置模板
# 复制为 .env 后修改实际值，或通过 docker-compose 传入

# ============ Grocy 连接 ============
# Grocy Web 访问地址（Docker 网络内用容器名，宿主机用局域网 IP）
GROCY_URL=http://grocy:80

# Grocy API Key（必须设置）
# 在 Grocy → 设置 → 系统 → API 中生成
GROCY_API_KEY=

# ============ 端口 ============
# HTTPS 端口（默认 9290）
PORT=9290

# HTTP-only 端口（默认 9291，用于开发调试 / CORS 测试）
HTTP_PORT=9291

# ============ ApiZero 条码查询 ============
# ApiZero 付费 Key（用于自动查询商品信息）
# 注册地址: https://www.apizero.cn/
# 免费额度有限，建议购买付费套餐
APIZERO_KEY=

# ============ 图片上传 ============
# 商品图片最大上传大小（bytes，默认 5MB）
MAX_IMAGE_SIZE=5242880
